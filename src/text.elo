// textkit: everyday helpers for text.
use std.regex

// "Hello, World!" -> "hello-world". Letters and digits from any script are
// kept; everything else becomes a single "-".
pub fn slugify(s: String) -> String {
    let lowered = s.lower().trim()
    let dashed = regex.replace(r"[^\p{L}\p{M}\p{N}]+", lowered, "-")
    return regex.replace(r"^-+|-+$", dashed, "")
}

// "the old man" -> "The Old Man"
pub fn title_case(s: String) -> String {
    return s.split(" ").map(|w| capitalize(w)).join(" ")
}

// "hello" -> "Hello"
pub fn capitalize(s: String) -> String {
    if s.is_empty() {
        return s
    }
    return s.slice(0, 1).upper() + s.slice(1, s.length)
}

// Shortens text to at most `max` letters, ending with "…" when cut.
pub fn truncate(s: String, max: Int) -> String {
    if s.length <= max {
        return s
    }
    if max <= 1 {
        return "…".slice(0, max)
    }
    return s.slice(0, max - 1).trim_end() + "…"
}

// Splits text into lines of at most `width` letters, breaking between words.
// A word longer than `width` gets a line of its own.
pub fn wrap(s: String, width: Int) -> List<String> {
    var lines: List<String> = []
    var current = ""
    for word in s.words() {
        if current.is_empty() {
            current = word
        } else if current.length + 1 + word.length <= width {
            current = current + " " + word
        } else {
            lines.push(current)
            current = word
        }
    }
    if !current.is_empty() {
        lines.push(current)
    }
    return lines
}

// True for "", "   " and other text with only spaces.
pub fn is_blank(s: String) -> Bool {
    return s.trim().is_empty()
}

pub fn count_words(s: String) -> Int {
    return s.words().length
}

// "first-name_here" -> "firstNameHere": camelCase from words separated by
// spaces, "-" or "_".
pub fn camel_case(s: String) -> String {
    let parts = regex.split(r"[\s_-]+", s.trim()).filter(|p| !p.is_empty())
    var out = ""
    for item in parts.enumerate() {
        out = out + match item.index == 0 {
            true => item.value.lower()
            false => capitalize(item.value.lower())
        }
    }
    return out
}

// "Hello World" -> "hello_world"
pub fn snake_case(s: String) -> String {
    let parts = regex.split(r"[\s-]+", s.trim()).filter(|p| !p.is_empty())
    return parts.map(|p| p.lower()).join("_")
}
